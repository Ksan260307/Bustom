{
  "name": "bustom",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "BLOSTOM - block robot assembly & battle game",
  "author": "Ksan",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:release": "vite build --mode release",
    "game": "npm run build:release && electron .",
    "game:dev": "electron . --dev-server=http://localhost:3000",
    "pack": "npm run build:release && electron-builder --dir",
    "smoke": "vite build && electron tests/smoke/smoke.cjs",
    "stage": "vite build --mode stage && electron electron/stage.js",
    "stage:dev": "vite --mode stage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "i18n:check": "node tools/check-i18n.mjs",
    "check": "npm run lint && npm run i18n:check && npm test",
    "pack:win": "npm run build:release && electron-builder --win",
    "pack:linux": "npm run build:release && electron-builder --linux",
    "bake:icon": "python tools/bake-icon.py",
    "smoke:packaged": "node tools/smoke-packaged.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "vite": "^5.4.10",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "jsqr": "^1.4.0",
    "qrcode-generator": "^2.0.4",
    "three": "^0.169.0"
  },
  "build": {
    "appId": "com.ksan.blostom",
    "productName": "BLOSTOM",
    "executableName": "BLOSTOM",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "!electron/stage.js",
      "build/icon.*",
      "dist/**/*",
      "!dist/**/*.map",
      "package.json"
    ],
    "win": {
      "target": [
        "dir"
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "linux": {
      "target": [
        "dir"
      ],
      "category": "Game",
      "icon": "build/icon.png"
    },
    "mac": {
      "target": [
        "dir"
      ],
      "category": "public.app-category.games",
      "icon": "build/icon.png"
    }
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "electron@33.4.11": true
  }
}
