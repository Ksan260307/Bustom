node_modules/
dist/
.vite/
*.log

# desktop builds
release/
release2/

# Per-developer: the App ID Steam looks for when the game is started outside
# the client. Never checked in, since it differs between the placeholder and
# the real one.
steam_appid.txt

# Raw asset downloads. The baked results live in public/kit/; see tools/README.md.
tools/dl/

# Downloaded and baked assets. Not ours, and reproducible: see tools/README.md
# for the one command that fetches and bakes the lot.
public/kit/

# The stage editor is built on its own; the game never ships it.
dist-stage/

# electron-builder's staging, but NOT the icon: that is drawn by
# tools/bake-icon.py and it is ours, so it is tracked like any other file we
# made. It also has to exist before a build can run.
build/*
!build/icon.png
!build/icon.ico

# Promo material. Not wanted, and a video is the one thing that must never
# go into git — 8.1MB that every clone pays for for ever, even after it is
# deleted, because git does not forget.
media/
*.mp4
*.mov
